# Core runtime
DATABASE_URL=postgresql+psycopg://claim_user:claim_password@localhost:5432/claim_assistant
JWT_SECRET=replace-with-a-long-local-secret
FRONTEND_ORIGIN=http://localhost:5173
CHECK_DATABASE_ON_HEALTH=true

# Local demo accounts. Change these values before sharing an environment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
ADJUSTER_EMAIL=adjuster@example.com
ADJUSTER_PASSWORD=change-this-adjuster-password

# Local file storage and processing adapters
UPLOAD_ROOT=uploads
DOCUMENT_OCR_MODE=deepdoc
DAMAGE_MODEL_MODE=local
DAMAGE_PART_MODEL_PATH=AI/models/car_part.pt
DAMAGE_MODEL_PATH=AI/models/car_damage.pt
DAMAGE_OUTPUT_DIR=backend/outputs/car_damage_detector
PART_SEARCH_MODE=mock

# LLM. Keep mock mode until a provider key and model are configured.
LLM_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional OpenAI-compatible provider endpoint. Leave empty for OpenAI.
LLM_BASE_URL=

# Docker Compose Postgres bootstrap
POSTGRES_DB=claim_assistant
POSTGRES_USER=claim_user
POSTGRES_PASSWORD=claim_password

# Advanced tuning uses the safe defaults in backend/app/core/config.py.
# Set only when a local integration needs an override:
# MAX_EVIDENCE_FILES=10
# MAX_EVIDENCE_FILE_SIZE_BYTES=10485760
# DAMAGE_PART_CONF=0.25
# DAMAGE_DAMAGE_CONF=0.15
# DAMAGE_MIN_PERCENT=3
# DAMAGE_IMAGE_SIZE=640
# DAMAGE_DEVICE=cpu
# DAMAGE_CONFIDENCE_THRESHOLD=0.70
# DAMAGE_REPAIR_MAX_PERCENTAGE=40
# DAMAGE_REPLACEMENT_MIN_PERCENTAGE=60
# LLM_REQUEST_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=0
# LLM_TOKEN_USAGE_LOG_ENABLED=false
# LLM_RAW_OUTPUT_LOG_ENABLED=false
